+
+extern "C" LLAMA_API int llama_gbcformer_set_stream(const char * name) {
+    int sel = -1;
+    for (size_t i = 0; name && i < gbcformer_stream_names.size(); ++i) {
+        if (gbcformer_stream_names[i] == name) {
+            sel = (int) i;
+        }
+    }
+    gbcformer_stream.store(sel);
